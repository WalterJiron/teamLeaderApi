# ------------------ PostgreSQL ------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=teamleader_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/teamleader_db

# ------------------ pgAdmin ------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ------------------ MongoDB ------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_DB_NAME=agent_memory_db
MONGO_URL=mongodb://admin:change-me@localhost:27017/?authSource=admin

# ------------------ Application ------------------
APP_ENV=development
LOG_LEVEL=INFO
APP_PUBLIC_URL=http://localhost:8000
ENABLE_DOCS=true
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=*
SECURITY_HSTS_ENABLED=false

# ------------------ Redis ------------------
REDIS_URL=redis://localhost:6379/0

# ------------------ JWT / Sessions ------------------
JWT_SECRET_KEY=change-me-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ISSUER=teamleader-api
JWT_AUDIENCE=teamleader-client
JWT_KEY_ID=primary
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=10080
MFA_CHALLENGE_EXPIRE_MINUTES=5

# ------------------ Encryption / MFA ------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=change-me-with-a-valid-fernet-key
# Separate Fernet key for GitHub access tokens and webhook secrets at rest.
CREDENTIALS_ENCRYPTION_KEY=change-me-with-a-valid-fernet-key
MFA_ISSUER_NAME=TeamLeader

# ------------------ Password policy ------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_HISTORY_SIZE=5
BREACHED_PASSWORD_CHECK_ENABLED=false
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_CHANGE_EXPIRE_HOURS=2
RECOVERY_EMAIL_EXPIRE_HOURS=24
INVITATION_EXPIRE_DAYS=7
ACCOUNT_RECOVERY_EXPIRE_DAYS=7

# ------------------ Authentication controls ------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
ALLOW_OPEN_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=false
AUTO_CREATE_TABLES=false
AUDIT_HASH_CHAIN_ENABLED=true
EMAIL_OUTBOX_INTERVAL_SECONDS=5

# ------------------ GitHub integration ------------------
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_API_TIMEOUT_SECONDS=10
GITHUB_API_MAX_RETRIES=3
GITHUB_SYNC_PAGE_SIZE=100
GITHUB_MAX_SYNC_PAGES=10
GITHUB_WEBHOOK_MAX_PAYLOAD_BYTES=1048576
GITHUB_WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# ------------------ Email (Mailpit for local development) ------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@teamlider.local
SMTP_FROM_NAME=TeamLeader
SMTP_USE_TLS=false
SMTP_USE_SSL=false
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_CHANGE_URL=http://localhost:3000/confirm-email-change
RECOVERY_EMAIL_URL=http://localhost:3000/confirm-recovery-email
INVITATION_URL=http://localhost:3000/accept-invitation

# ------------------ n8n / ngrok ------------------
NGROK_AUTHTOKEN=change-me
DOMAIN_NAME=ngrok-free.dev
SUBDOMAIN=change-me
GENERIC_TIMEZONE=America/Managua
TZ=America/Managua
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_AGENT_WEBHOOK_URL=http://localhost:5678/webhook/agent
N8N_INTERNAL_API_KEY=change-me
N8N_CHATBOT_URL=https://change-me.ngrok-free.dev/webhook/change-me/chat
SSL_EMAIL=admin@example.com

# ------------------ Supabase (optional) ------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=Imagenes
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
